# Copy to .env.local (gitignored) for local development. Dummy values only.
# Every EXPO_PUBLIC_* value is bundled into the app, so never put a secret here (R25.2).
# Production values live only in the EAS `production` environment (R24.6).

# The local Supabase stack. A LAN address such as http://192.168.1.20:54321 lets a phone reach it.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# The publishable key that `npx supabase status` prints. Never the secret key.
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Optional in development; required in production. Leave empty to turn error reporting off.
EXPO_PUBLIC_SENTRY_DSN=
