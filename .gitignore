# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Generated native folders (Continuous Native Generation)
/ios
/android

# Native signing material — never commit
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.pem
*.mobileprovision

# Metro
.metro-health-check*

# Environment files — never commit real values. Only .env.example is tracked.
.env
.env.*
!.env.example

# Supabase CLI local state
supabase/.branches
supabase/.temp
supabase/.env

# Sentry CLI / build plugin (may contain auth tokens)
.sentryclirc
.env.sentry-build-plugin
sentry.properties

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# TypeScript
*.tsbuildinfo

# Coverage
coverage/

# macOS / editors
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
